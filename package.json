{
  "name": "isaac-rebirth-browser-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "npm run build:wasm && vite build",
    "typecheck": "tsc --noEmit",
    "test:browser": "bash tools/original/with-display.sh node node_modules/@playwright/test/cli.js test",
    "check": "npm run matrix:check && npm run typecheck && npm run build && npm run test:lint && npm run test:engine && npm run test:rooms && npm run test:browser && npm run test:verification && npm run test:clock && npm run test:graphics-observer && npm run test:original-contracts && npm run test:original-clock && npm run test:original-seeds && npm run test:original-backdrop && npm run verify:foundation",
    "assets:check": "python3 tools/check-assets.py",
    "assets:rooms": "python3 tools/foundation/decode-rooms.py --all-base",
    "test:rooms": "python3 tools/foundation/decode-rooms-checks.py",
    "build:wasm": "bash tools/build-wasm.sh",
    "test:engine": "cargo test --manifest-path engine/Cargo.toml --locked",
    "test:lint": "cargo clippy --manifest-path engine/Cargo.toml --locked --all-targets -- -D warnings",
    "test:seeds": "node tools/foundation/seed-invariants.mjs",
    "test:original-seeds": "node tools/foundation/original-seed-contract.mjs --capture --count 4 --jobs 2",
    "test:original-backdrop": "cargo build --manifest-path engine/Cargo.toml --bin backdrop --locked && python3 tools/original/foundation-backdrop-verify.py --capture --count 2 --jobs 2",
    "test:verification": "node --test tools/foundation/*.test.mjs",
    "test:host": "bash tools/original/compat/test-host.sh",
    "verify:foundation": "bash tools/original/with-display.sh node tools/foundation/verify.mjs",
    "matrix:update": "node tools/foundation/matrix.mjs --write",
    "matrix:check": "node tools/foundation/matrix.mjs --check",
    "test:clock": "python3 tools/original/foundation-clock-gate-checks.py && python3 tools/original/foundation-clock-verify-checks.py",
    "test:original-clock": "python3 tools/original/foundation-clock-verify.py --count 2 --jobs 2",
    "test:graphics-observer": "python3 tools/original/foundation-gl-observe-checks.py",
    "test:original-contracts": "python3 tools/original/foundation-seeds-checks.py && python3 tools/original/foundation-random-seeds-checks.py && python3 tools/original/debug-smoke-checks.py && python3 tools/original/foundation-descriptor-observer-checks.py && python3 tools/original/foundation-backdrop-verify-checks.py && python3 tools/original/foundation-stage-mask-capture-checks.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
