{
  "name": "isaac-rebirth-browser-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "npm run build:wasm && vite build",
    "playtest:bundle": "node tools/playtest/bundle.mjs",
    "playtest:self": "node tools/playtest/playtest.mjs",
    "playtest:video": "node tools/playtest/side-by-side.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "bash tools/original/with-display.sh node node_modules/@playwright/test/cli.js test",
    "check": "npm run check:build && npm run test:e2e",
    "check:build": "npm run assets:check && npm run test:policy && npm run matrix:check && npm run typecheck && npm run build",
    "assets:check": "python3 tools/check-assets.py",
    "assets:rooms": "python3 tools/foundation/decode-rooms.py --all-base",
    "build:wasm": "bash tools/build-wasm.sh",
    "verify:foundation": "bash tools/original/with-display.sh node tools/foundation/verify.mjs",
    "matrix:update": "node tools/foundation/matrix.mjs --write",
    "matrix:check": "node tools/foundation/matrix.mjs --check",
    "test:original-clock": "python3 tools/original/foundation-clock-verify.py --count 2 --jobs 2",
    "lint": "cargo clippy --manifest-path engine/Cargo.toml --locked --all-targets -- -D warnings",
    "lint:dst": "python3 tools/dst/sync-lock.py && cargo fmt --manifest-path engine/dst/Cargo.toml --check && cargo clippy --manifest-path engine/dst/Cargo.toml --locked --all-targets -- -D warnings",
    "test:dst": "bash tools/dst/run.sh",
    "format": "cargo fmt --manifest-path engine/Cargo.toml",
    "format:check": "cargo fmt --manifest-path engine/Cargo.toml --check",
    "upkeep:check": "npm run lint && npm run format:check",
    "test:e2e": "node tools/e2e/run.mjs",
    "test:e2e:paired": "node tools/e2e/run.mjs paired",
    "test:policy": "node tools/e2e/policy.mjs",
    "affected:map": "node tools/e2e/affected.mjs --update-map",
    "case:keep": "node tools/e2e/keep-case.mjs",
    "assets:minimap": "python3 tools/foundation/prepare-minimap.py",
    "predev": "npm run assets:minimap",
    "pretypecheck": "npm run assets:minimap",
    "prebuild": "npm run assets:minimap"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
